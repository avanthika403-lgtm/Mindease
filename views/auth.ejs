<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= mode === 'register' ? 'Create your space' : 'Welcome back' %> | Mind Ease</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/styles.css">
</head>
<body class="auth-page">
  <header class="public-nav wrap"><a class="brand" href="/" aria-label="Mind Ease home"><span class="brand-mark"><i></i><i></i><i></i></span><span>mind ease</span></a><a class="text-link" href="/">Back to home <span aria-hidden="true">↗</span></a></header>
  <main class="auth-layout wrap">
    <section class="auth-aside">
      <p class="eyebrow"><span class="eyebrow-dot"></span> Your space, at your pace</p>
      <h1><%= mode === 'register' ? 'Start where you are.' : 'Good to see you again.' %></h1>
      <p><%= mode === 'register' ? 'A small check-in is enough. You can take it one moment at a time.' : 'Come back to your reflections, routines, and small steps forward.' %></p>
      <div class="auth-aside-note"><span class="auth-leaf">✳</span><span>Private by design.<br>Gentle by nature.</span></div>
    </section>
    <section class="auth-form-wrap">
      <p class="eyebrow"><%= mode === 'register' ? 'Create an account' : 'Sign in' %></p>
      <h2><%= mode === 'register' ? 'Make room for you.' : 'Pick up where you left off.' %></h2>
      <% if (flash) { %><p class="notice notice-<%= flash.type %>" role="alert"><%= flash.message %></p><% } %>
      <form class="stack-form" action="/<%= mode %>" method="post">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <% if (mode === 'register') { %><label for="name">Your name<input id="name" name="name" autocomplete="name" maxlength="80" required></label><% } %>
        <label for="email">Email address<input id="email" name="email" type="email" autocomplete="email" maxlength="254" required></label>
        <label for="password">Password<input id="password" name="password" type="password" autocomplete="<%= mode === 'register' ? 'new-password' : 'current-password' %>" minlength="<%= mode === 'register' ? '10' : '1' %>" required><% if (mode === 'register') { %><span class="field-hint">Use at least 10 characters.</span><% } %></label>
        <button class="button button-dark button-wide" type="submit"><%= mode === 'register' ? 'Create your account' : 'Sign in securely' %> <span aria-hidden="true">↗</span></button>
      </form>
      <p class="auth-switch"><%= mode === 'register' ? 'Already have an account?' : 'New to Mind Ease?' %> <a href="/<%= mode === 'register' ? 'login' : 'register' %>"><%= mode === 'register' ? 'Log in' : 'Create an account' %></a></p>
      <p class="privacy-caption">Your reflections belong to you. We never sell personal wellness data.</p>
    </section>
  </main>
  <footer class="auth-footer wrap"><span>Mind Ease</span><span>A self-help tool, not a replacement for professional care.</span></footer>
</body>
</html>