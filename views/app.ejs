<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= ({dashboard:'Your day',mood:'Mood check-in',diary:'Thought diary',chat:'USHA companion',care:'A moment of care',insights:'Mood insights',help:'Support',settings:'Your settings'})[page] %> | Mind Ease</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <meta name="csrf-token" content="<%= csrfToken %>">
  <link rel="stylesheet" href="/styles.css">
  <script src="/app.js" defer></script>
</head>
<body class="workspace-page">
  <div class="workspace-shell">
    <div class="sidebar-backdrop" id="sidebar-backdrop"></div>
    <aside class="sidebar" id="sidebar">
      <a class="brand" href="/dashboard" aria-label="Mind Ease dashboard"><span class="brand-mark"><i></i><i></i><i></i></span><span>mind ease</span></a>
      <p class="side-label">YOUR SPACE</p>
      <nav class="side-nav" aria-label="Your space">
        <a class="side-link <%= page==='dashboard'?'active':'' %>" href="/dashboard"><span class="nav-symbol">⌂</span>Overview</a>
        <a class="side-link <%= page==='mood'?'active':'' %>" href="/mood"><span class="nav-symbol">◷</span>Mood check-in</a>
        <a class="side-link <%= page==='diary'?'active':'' %>" href="/diary"><span class="nav-symbol">▤</span>Thought diary</a>
        <a class="side-link <%= page==='chat'?'active':'' %>" href="/chat"><span class="nav-symbol">○</span>Talk with USHA</a>
      </nav>
      <p class="side-label side-label-spaced">TAKE A PAUSE</p>
      <nav class="side-nav" aria-label="Wellness tools">
        <a class="side-link <%= page==='care'?'active':'' %>" href="/care"><span class="nav-symbol">✳</span>Self-care</a>
        <a class="side-link <%= page==='insights'?'active':'' %>" href="/insights"><span class="nav-symbol">⌁</span>Your patterns</a>
      </nav>
      <div class="sidebar-bottom">
        <a class="support-link <%= page==='help'?'active':'' %>" href="/help"><span class="nav-symbol">?</span>Help & crisis support</a>
        <a class="profile-link <%= page==='settings'?'active':'' %>" href="/settings"><span class="avatar"><%= user.name.slice(0,1).toUpperCase() %></span><span class="profile-name"><strong><%= user.name %></strong><small>Personal space</small></span><span class="profile-more">···</span></a>
      </div>
    </aside>

    <main class="main-shell">
      <header class="workspace-topbar"><button class="mobile-menu" type="button" aria-label="Open navigation" aria-expanded="false" data-menu-toggle>☰</button><span class="topbar-date"><%= new Date().toLocaleDateString('en', { weekday:'long', month:'long', day:'numeric' }) %></span><a class="topbar-help" href="/help">Need support?</a></header>
      <div class="page-content">
        <% if (demoMode) { %><p class="demo-banner">Local demo mode: entries are stored in memory and clear when the server restarts. Add Supabase with <code>SUPABASE_DB_URL</code> (or PostgreSQL with <code>DATABASE_URL</code>) for persistent storage.</p><% } %>
        <% if (flash) { %><p class="notice notice-<%= flash.type %>" role="status"><%= flash.message %></p><% } %>

        <% if (page === 'dashboard') { %>
          <section class="page-heading heading-with-tag"><div><p class="eyebrow"><span class="eyebrow-dot"></span> YOUR SPACE, YOUR PACE</p><h1>Good <%= new Date().getHours() < 12 ? 'morning' : new Date().getHours() < 17 ? 'afternoon' : 'evening' %>, <%= user.name.split(' ')[0] %>.</h1><p class="heading-subtitle">There’s no right way to feel. Start with what’s here.</p></div><span class="soft-tag"><span class="status-dot"></span> Just for you</span></section>
          <section class="dashboard-focus"><div class="focus-copy"><p class="eyebrow eyebrow-light">A SMALL MOMENT FOR YOU</p><h2><%= todayMood ? 'You showed up for yourself today.' : 'How are you arriving today?' %></h2><p><%= todayMood ? 'Your check-in is saved. You can always add a note or explore what might help next.' : 'A number, a word, a breath. Any kind of check-in counts.' %></p><a class="button button-light" href="/mood"><%= todayMood ? 'See your check-in' : 'Check in with yourself' %> <span aria-hidden="true">↗</span></a></div><div class="focus-orbit" aria-hidden="true"><span class="orbit-ring"></span><span class="orbit-core">✳</span><span class="orbit-caption">right<br>here</span></div></section>
          <div class="dashboard-columns"><section class="content-section"><div class="section-heading"><div><p class="eyebrow">A LOOK BACK</p><h2>Your recent check-ins</h2></div><a class="text-link" href="/insights">All patterns <span aria-hidden="true">↗</span></a></div>
            <% if (moods.length) { %><div class="mini-chart" aria-label="Recent mood scores"><% moods.slice(0,7).reverse().forEach((entry) => { %><div class="mini-bar-column"><span class="mini-bar-value"><%= entry.score %></span><div class="mini-bar-track"><span class="mini-bar" style="height:<%= entry.score * 10 %>%"></span></div><span class="mini-bar-day"><%= new Date(entry.entry_date).toLocaleDateString('en',{weekday:'short'}) %></span></div><% }) %></div><% } else { %><div class="empty-line"><p>No check-ins yet. Your first one can be brief.</p><a class="text-link" href="/mood">Add a mood <span aria-hidden="true">↗</span></a></div><% } %>
          </section><section class="content-section today-section"><div class="section-heading"><div><p class="eyebrow">A GENTLE NUDGE</p><h2>Choose what fits</h2></div></div><a class="activity-row" href="/care"><span class="activity-mark mark-coral">01</span><span><strong>Take one slow breath</strong><small>Try a guided 4-7-8 reset</small></span><span class="activity-arrow">↗</span></a><a class="activity-row" href="/diary"><span class="activity-mark mark-lime">02</span><span><strong>Set a thought down</strong><small>Make space for another view</small></span><span class="activity-arrow">↗</span></a><a class="activity-row" href="/chat"><span class="activity-mark mark-blue">03</span><span><strong>Talk it through</strong><small>USHA is here to listen</small></span><span class="activity-arrow">↗</span></a></section></div>
          <section class="quote-strip"><span class="quote-mark">“</span><p>You don’t have to figure everything out right now.</p><span class="quote-source">A NOTE TO KEEP</span></section>

        <% } else if (page === 'mood') { %>
          <section class="page-heading"><p class="eyebrow"><span class="eyebrow-dot"></span> NOTICE WITHOUT JUDGMENT</p><h1>Mood check-in</h1><p class="heading-subtitle">A snapshot, not a scorecard. What’s the weather like inside?</p></section>
          <div class="form-and-aside"><form class="surface-form" action="/mood" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><fieldset class="mood-fieldset"><legend>Choose a number that feels close</legend><div class="mood-scale"><% for(let score=1;score<=10;score++){ %><label class="mood-choice"><input type="radio" name="score" value="<%= score %>" <%= score===5?'checked':'' %>><span><%= score %></span></label><% } %></div><div class="scale-caption"><span>Hard to be here</span><span>Feeling good</span></div></fieldset><label class="form-label" for="mood-note">What’s on your mind? <span class="optional">Optional</span><textarea id="mood-note" name="note" rows="3" maxlength="500" placeholder="A few words are enough..."></textarea></label><div class="form-row"><label class="form-label" for="screen-time">Screen time today <span class="optional">Optional</span><span class="input-with-suffix"><input id="screen-time" type="number" min="0" max="1440" name="screen_minutes" placeholder="0"><span>minutes</span></span></label><label class="form-label" for="entry-date">Date<input id="entry-date" type="date" name="entry_date" value="<%= new Date().toISOString().slice(0,10) %>" required></label></div><button class="button button-dark" type="submit">Save check-in <span aria-hidden="true">↗</span></button></form>
            <aside class="aside-note"><p class="eyebrow">A THOUGHT TO HOLD</p><h2>Feelings are information, not instructions.</h2><p>There’s no need to change how you feel. Noticing is already a useful first step.</p><div class="note-line"></div><span class="note-detail">Your check-ins are visible only to you.</span></aside></div>
          <section class="content-section history-section"><div class="section-heading"><div><p class="eyebrow">YOUR RECENT ENTRIES</p><h2>Looking back</h2></div><a class="text-link" href="/insights">See patterns <span aria-hidden="true">↗</span></a></div><% if(moods.length){ %><div class="entry-list"><% moods.slice(0,8).forEach((entry)=>{ %><article class="entry-row mood-entry-card"><div class="mood-entry-heading"><span class="entry-date"><%= new Date(entry.entry_date).toLocaleDateString('en',{weekday:'long',month:'short',day:'numeric'}) %></span><span class="entry-score" aria-label="Mood score <%= entry.score %> out of 10"><%= entry.score %></span></div><div class="entry-main"><strong><%= entry.note || 'Mood check-in' %></strong><small>Mood score · <%= entry.score %> out of 10</small></div><div class="mood-entry-meter" aria-hidden="true"><span style="width:<%= entry.score * 10 %>%"></span></div><% if (entry.screen_minutes !== null && entry.screen_minutes !== undefined) { %><span class="entry-meta"><span aria-hidden="true">◷</span> <%= entry.screen_minutes %> min screen time</span><% } %></article><% }) %></div><% } else { %><p class="quiet-empty">Your saved check-ins will appear here.</p><% } %></section>

        <% } else if (page === 'diary') { %>
          <section class="page-heading"><p class="eyebrow"><span class="eyebrow-dot"></span> A GUIDED CBT REFLECTION</p><h1>Thought diary</h1><p class="heading-subtitle">You don’t have to believe every thought. Let’s look at one with curiosity.</p></section>
          <form class="surface-form diary-form" action="/diary" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="diary-intro"><span class="step-marker">01</span><div><h2>Start with a moment</h2><p>Take one situation at a time. Share only what feels okay.</p></div></div><label class="form-label" for="situation">What happened? <textarea id="situation" name="situation" rows="2" maxlength="1800" placeholder="Describe the situation, just the facts as you remember them..." required></textarea></label><div class="form-row"><label class="form-label" for="thought">What went through your mind? <textarea id="thought" name="thought" rows="3" maxlength="1800" placeholder="Write down the automatic thought..." required></textarea></label><label class="form-label" for="feeling">What did you feel? <textarea id="feeling" name="feeling" rows="3" maxlength="1800" placeholder="Name the feeling, and how strong it was..." required></textarea></label></div><div class="diary-intro"><span class="step-marker step-marker-coral">02</span><div><h2>Look at the thought</h2><p>What supports it? What might offer another perspective?</p></div></div><div class="form-row"><label class="form-label" for="evidence-for">Evidence that supports this thought <span class="optional">Optional</span><textarea id="evidence-for" name="evidence_for" rows="3" maxlength="1800" placeholder="What facts seem to support it?"></textarea></label><label class="form-label" for="evidence-against">Evidence that doesn’t support it <span class="optional">Optional</span><textarea id="evidence-against" name="evidence_against" rows="3" maxlength="1800" placeholder="What might you be leaving out?"></textarea></label></div><label class="form-label" for="balanced-thought">A more balanced thought<textarea id="balanced-thought" name="balanced_thought" rows="3" maxlength="1800" placeholder="What would you say to someone you care about in this situation?" required></textarea></label><button class="button button-dark" type="submit">Save reflection <span aria-hidden="true">↗</span></button></form>
          <section class="content-section history-section"><div class="section-heading"><div><p class="eyebrow">YOUR REFLECTIONS</p><h2>Previous entries</h2></div></div><% if(diaries.length){ %><div class="entry-list"><% diaries.forEach((entry)=>{ %><details class="diary-entry diary-entry-card"><summary><span class="diary-entry-card-top"><small><%= new Date(entry.created_at).toLocaleDateString('en',{month:'short',day:'numeric',year:'numeric'}) %></small><span class="diary-entry-toggle" aria-hidden="true">⌄</span></span><span class="diary-entry-card-copy"><strong><%= entry.situation %></strong><small>Open reflection <span aria-hidden="true">↗</span></small></span></summary><div class="diary-entry-body"><p><b>Automatic thought</b><br><%= entry.thought %></p><p><b>Feeling</b><br><%= entry.feeling %></p><p><b>Evidence for</b><br><%= entry.evidence_for || 'Not recorded' %></p><p><b>Evidence against</b><br><%= entry.evidence_against || 'Not recorded' %></p><p><b>Balanced thought</b><br><%= entry.balanced_thought %></p></div></details><% }) %></div><% } else { %><p class="quiet-empty">Your saved reflections will live here.</p><% } %></section>

        <% } else if (page === 'chat') { %>
          <section class="page-heading"><p class="eyebrow"><span class="eyebrow-dot"></span> A SUPPORTIVE MOMENT</p><h1>Talk with USHA</h1><p class="heading-subtitle">A gentle companion for reflection and everyday concerns.</p></section>
          <section class="chat-shell"><div class="chat-header"><span class="usha-avatar">✳</span><div><strong>USHA</strong><small>Here to listen, one moment at a time</small></div><span class="chat-status"><i></i> Ready</span></div><div class="chat-messages" data-chat-messages aria-live="polite"><div class="chat-message assistant"><span class="chat-message-mark">✳</span><p>Hi, <%= user.name.split(' ')[0] %>. I’m here with you. What’s been on your mind?</p></div></div><div class="prompt-row"><button type="button" data-prompt="I feel a little overwhelmed today.">I feel overwhelmed</button><button type="button" data-prompt="Help me reflect on something that happened.">Help me reflect</button><button type="button" data-prompt="Can we try a small grounding exercise?">I need a pause</button></div><form class="chat-composer" data-chat-form><label class="sr-only" for="chat-message">Message USHA</label><textarea id="chat-message" name="message" rows="1" maxlength="2000" placeholder="Share what feels okay..."></textarea><button type="submit" aria-label="Send message">Send <span aria-hidden="true">↗</span></button></form><p class="chat-disclaimer">If Groq is configured, your message and recent chat context are sent to Groq to generate a reply. Don’t include details you would not want to share with that provider. Chats are not saved by Mind Ease. USHA is not a therapist or emergency service. <a href="/help">Get immediate support</a></p></section>

        <% } else if (page === 'care') { %>
          <section class="page-heading"><p class="eyebrow"><span class="eyebrow-dot"></span> YOU CAN PAUSE HERE</p><h1>A moment of care</h1><p class="heading-subtitle">No fixing, no rush. Choose one small practice and take it at your pace.</p></section>
          <section class="breath-panel"><div class="breath-copy"><p class="eyebrow eyebrow-light">FOLLOW YOUR OWN PACE</p><h2>Let your breath<br>find its rhythm.</h2><p>A gentle 4-7-8 pattern. If holding your breath doesn’t feel comfortable, return to an easy, natural breath.</p><button type="button" class="button button-light" data-breath-start>Begin breathing <span aria-hidden="true">↗</span></button></div><div class="breath-visual"><div class="breath-circle" data-breath-circle><span data-breath-label>Ready</span></div><p data-breath-count aria-live="polite">A few cycles · stop whenever you like</p></div></section>
          <section class="grounding-section"><div class="section-heading"><div><p class="eyebrow">WHEN YOU FEEL UNSETTLED</p><h2>Come back to your senses</h2><p class="section-subtitle">Look around and gently notice, without needing to change anything.</p></div></div><div class="grounding-grid"><article><span>5</span><h3>Things you can see</h3><p>Let your eyes rest on five things around you.</p></article><article><span>4</span><h3>Things you can feel</h3><p>Notice four points of contact or texture.</p></article><article><span>3</span><h3>Things you can hear</h3><p>Listen for three sounds, near or far.</p></article><article><span>2</span><h3>Things you can smell</h3><p>Find two scents, or imagine a familiar one.</p></article><article><span>1</span><h3>Thing you can taste</h3><p>Notice one taste, or take a sip of water.</p></article></div></section>
          <section class="mindful-strip"><div><p class="eyebrow">A ONE-MINUTE PAUSE</p><h2>Unclench your jaw.<br>Let your shoulders drop.</h2></div><p>Feel your feet where they meet the floor. Notice one thing that is steady beneath you. You don’t need to make this moment perfect.</p></section><section class="suggestion-row"><span class="activity-mark mark-coral">TODAY</span><p><strong>Try a small reset:</strong> Step outside for a few minutes, stretch gently, or message someone who feels safe.</p><a class="text-link" href="/chat">Talk with USHA <span aria-hidden="true">↗</span></a></section>

        <% } else if (page === 'insights') { const entries = moods.slice(0,30).reverse(); const average = moods.length ? (moods.reduce((sum,item)=>sum+Number(item.score),0)/moods.length).toFixed(1) : '—'; %>
          <section class="page-heading"><p class="eyebrow"><span class="eyebrow-dot"></span> OBSERVE, DON’T JUDGE</p><h1>Your patterns</h1><p class="heading-subtitle">A gentle look at what you’ve noticed over time.</p></section>
          <div class="insight-stats"><article><p class="eyebrow">CHECK-INS SAVED</p><strong><%= moods.length %></strong><span>moments of noticing</span></article><article><p class="eyebrow">AVERAGE MOOD</p><strong><%= average %><small>/10</small></strong><span>across your check-ins</span></article><article><p class="eyebrow">REFLECTIONS</p><strong><%= diaries.length %></strong><span>thoughts explored</span></article></div>
          <section class="content-section chart-section"><div class="section-heading"><div><p class="eyebrow">YOUR LAST <%= Math.min(entries.length,30) %> CHECK-INS</p><h2>Mood over time</h2></div><span class="chart-legend"><i></i> Mood, 1–10</span></div><% if(entries.length){ %><div class="insights-chart"><div class="chart-y-labels"><span>10</span><span>7</span><span>4</span><span>1</span></div><div class="chart-columns"><% entries.forEach((entry)=>{ %><div class="chart-column"><span class="chart-score"><%= entry.score %></span><div class="chart-bar-wrap"><span class="chart-bar" style="height:<%= Number(entry.score)*10 %>%"></span></div><small><%= new Date(entry.entry_date).toLocaleDateString('en',{month:'short',day:'numeric'}) %></small></div><% }) %></div></div><% } else { %><div class="empty-line"><p>Your chart will take shape as you check in. There’s no target to reach.</p><a class="text-link" href="/mood">Add your first check-in <span aria-hidden="true">↗</span></a></div><% } %></section>
          <section class="pattern-note"><span class="pattern-mark">⌁</span><div><p class="eyebrow">A NOTE ABOUT PATTERNS</p><h2>Trends aren’t the whole story.</h2><p>Mood can shift for many reasons. These check-ins are a personal reflection tool, not a diagnosis or a prediction.</p></div></section>

        <% } else if (page === 'help') { %>
          <section class="page-heading"><p class="eyebrow"><span class="eyebrow-dot"></span> SUPPORT IS AVAILABLE</p><h1>You don’t have to do this alone.</h1><p class="heading-subtitle">If things feel heavy or unsafe, reaching out is a strong next step.</p></section>
          <section class="crisis-panel"><div><p class="eyebrow eyebrow-light">IF YOU MAY BE IN IMMEDIATE DANGER</p><h2>Get help right now.</h2><p>Call your local emergency number or go to the nearest emergency department. If you can, ask a trusted person to stay with you.</p></div><a class="button button-light" href="tel:112">Call 112 <span aria-hidden="true">↗</span></a></section>
          <section class="resources-section"><div class="section-heading"><div><p class="eyebrow">TALK TO SOMEONE</p><h2>Trusted support lines</h2></div></div><div class="resource-list"><article><div><p class="resource-region">UNITED STATES & CANADA</p><h3>988 Suicide & Crisis Lifeline</h3><p>Free, confidential support by call or text, 24/7.</p></div><a class="resource-number" href="tel:988">Call or text 988 <span aria-hidden="true">↗</span></a></article><article><div><p class="resource-region">INDIA</p><h3>Tele-MANAS</h3><p>National tele-mental health support, available 24/7.</p></div><a class="resource-number" href="tel:14416">Call 14416 <span aria-hidden="true">↗</span></a></article><article><div><p class="resource-region">ANYWHERE</p><h3>Find local crisis support</h3><p>Find A Helpline lists verified services in more than 130 countries.</p></div><a class="resource-number" href="https://findahelpline.com" target="_blank" rel="noreferrer">Find a helpline <span aria-hidden="true">↗</span></a></article></div></section>
          <section class="help-steps"><p class="eyebrow">ONE STEP AT A TIME</p><h2>When it’s hard to know what to do</h2><ol><li><span>01</span>Move somewhere you feel safer, if you can.</li><li><span>02</span>Tell someone you trust what’s happening.</li><li><span>03</span>Contact a crisis service or a mental health professional.</li><li><span>04</span>If there’s immediate danger, call emergency services now.</li></ol><p class="resource-footnote">Numbers and services may vary by location. If a number doesn’t connect, contact your local emergency service.</p></section>

        <% } else if (page === 'settings') { %>
          <section class="page-heading"><p class="eyebrow"><span class="eyebrow-dot"></span> YOUR ACCOUNT, YOUR CHOICES</p><h1>Profile & privacy</h1><p class="heading-subtitle">Your personal space, with the controls in your hands.</p></section>
          <section class="settings-section"><div class="settings-heading"><p class="eyebrow">PROFILE</p><h2>Your details</h2></div><form class="settings-form profile-form" action="/settings/profile" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="form-label" for="profile-name">Name<input id="profile-name" name="name" value="<%= user.name %>" maxlength="80" required></label><label class="form-label" for="profile-email">Email<input id="profile-email" name="email" type="email" value="<%= user.email %>" maxlength="254" required></label><button class="button button-dark" type="submit">Save profile</button></form></section>
          <section class="settings-section"><div class="settings-heading"><p class="eyebrow">ACCOUNT SECURITY</p><h2>Change password</h2></div><form class="settings-form" action="/settings/password" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="form-label" for="current-password">Current password<input type="password" id="current-password" name="current_password" autocomplete="current-password" required></label><label class="form-label" for="new-password">New password<input type="password" id="new-password" name="new_password" minlength="10" autocomplete="new-password" required><span class="field-hint">At least 10 characters.</span></label><button class="button button-dark" type="submit">Update password</button></form></section>
          <section class="settings-section privacy-section"><div class="settings-heading"><p class="eyebrow">PRIVACY</p><h2>Your data stays personal.</h2><p>Mind Ease doesn’t sell personal wellness data. Your mood entries and diary reflections are linked to your account and encrypted at rest.</p></div><form action="/logout" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button button-outline" type="submit">Sign out</button></form></section>
          <section class="settings-section danger-section"><div class="settings-heading"><p class="eyebrow">IRREVERSIBLE</p><h2>Delete your account and entries</h2><p>This permanently removes your account, mood history, and thought diary.</p></div><form class="settings-form delete-form" action="/settings/delete" method="post" data-confirm="Delete your account and all personal entries? This cannot be undone."><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="form-label" for="delete-password">Confirm with your password<input type="password" id="delete-password" name="password" autocomplete="current-password" required></label><button class="button button-danger" type="submit">Delete account and data</button></form></section>
        <% } %>

        <footer class="workspace-footer"><span>Mind Ease · Self-help, not a substitute for professional care.</span><a href="/help">Support resources <span aria-hidden="true">↗</span></a></footer>
      </div>
    </main>
  </div>
</body>
</html>